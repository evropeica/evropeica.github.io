---
import Base from '../layouts/Base.astro';
---

<Base title="Konvérter" description="Live transliteration converter — type in Cyrillic, see Latin output">
  <h1 class="bi"><span class="lat">Konvérter</span><span class="cyr">Конвертер</span></h1>

  <div class="bi">
    <p>Vvedíť tekst kyrýłyceju — pobáčyte rezultát łatýnkoju v reálnomu časi.</p>
    <p class="cyr">Введіть текст кирилицею — побачите результат латинкою в реальному часі.</p>
  </div>

  <div class="converter">
    <div class="converter-panel">
      <label for="input">Кирилиця (input)</label>
      <textarea id="input" rows="8" placeholder="Введіть текст українською..."></textarea>
    </div>
    <div class="converter-panel">
      <label for="output">Латинка (output)</label>
      <textarea id="output" rows="8" readonly></textarea>
    </div>
  </div>

  <div class="examples">
    <h3 class="bi"><span class="lat">Prykłady</span><span class="cyr">Приклади</span></h3>
    <div class="example-chips">
      <button class="chip" data-text="Київ — столиця України">Київ</button>
      <button class="chip" data-text="Щастя не купиш за гроші">Щастя</button>
      <button class="chip" data-text="Всі люди народжуються вільними і рівними у своїй гідності та правах">Декларація</button>
      <button class="chip" data-text="М'яч, п'ять, об'єм, кур'єр">Апостроф</button>
      <button class="chip" data-text="Джерело, дзвін, дзьоб, підживити, надзвичайний">Диграфи</button>
      <button class="chip" data-text="Знання, життя, Ілля, мільярд, Нью-Йорк">М'які</button>
      <button class="chip" data-text="Ще не вмерла України ні слава, ні воля">Гімн</button>
    </div>
  </div>
</Base>

<script>
  import { transliterate } from '../lib/transliterate';

  const input = document.getElementById('input') as HTMLTextAreaElement;
  const output = document.getElementById('output') as HTMLTextAreaElement;

  input.addEventListener('input', () => {
    output.value = transliterate(input.value);
  });

  document.querySelectorAll('.chip').forEach(btn => {
    btn.addEventListener('click', () => {
      const text = (btn as HTMLElement).dataset.text || '';
      input.value = text;
      output.value = transliterate(text);
    });
  });
</script>

<style>
  .cyr { color: var(--ink-soft); }

  .converter {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin: 1.5rem 0;
  }

  @media (max-width: 640px) {
    .converter { grid-template-columns: 1fr; }
  }

  .converter-panel label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
    color: var(--ink-soft);
  }

  textarea {
    width: 100%;
    padding: 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.6;
    resize: vertical;
    background: var(--surface);
  }

  textarea:focus {
    outline: none;
    border-color: var(--brand);
    box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.1);
  }

  textarea[readonly] {
    background: #f9fafb;
    color: var(--ink);
  }

  .examples { margin-top: 2rem; }

  .example-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .chip {
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 20px;
    background: var(--surface);
    cursor: pointer;
    font-size: 0.85rem;
    transition: all 0.15s;
  }

  .chip:hover {
    border-color: var(--brand);
    background: #eff6ff;
  }
</style>
