---
import { withBase } from '../lib/url';

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}

const { title, description = 'Evropéïća — Ukrainian Latin orthography project', wide = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const nav = [
  { href: '/spec/', label: 'Spec' },
  { href: '/spec/v1/', label: 'v1.0' },
  { href: '/spec/v2/', label: 'v2.0' },
  { href: '/converter/', label: 'Konverter' },
  { href: '/keyboard/', label: 'Kłaviatura' },
];
const isActive = (href: string) => path === href.replace(/\/$/, '');
---

<!doctype html>
<html lang="uk">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <title>{title} | Evropéïća</title>
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="preload" as="font" type="font/woff2" crossorigin
          href={withBase('/fonts/literata-latin-normal.woff2')} />
    <link rel="stylesheet" href={withBase('/fonts/literata.css')} />
  </head>
  <body>
    <a class="skip" href="#main">Do zmistu</a>

    <header class="site-head">
      <div class="head-inner">
        <a href={withBase('/')} class="brand">
          <span class="brand-mark">E</span>
          <span class="brand-name">Evropéïća</span>
        </a>
        <nav class="nav" aria-label="Hołovna navigacija">
          {nav.map(item => (
            <a href={withBase(item.href)} class:list={['nav-link', { active: isActive(item.href) }]}>
              {item.label}
            </a>
          ))}
        </nav>
      </div>
    </header>

    <main id="main" class:list={['main', { wide }]}>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="foot-inner">
        <p class="foot-brand">Evropéïća</p>
        <nav class="foot-links" aria-label="Dodatkovi posyłanńa">
          <a href="https://github.com/evropeica/evropeica.github.io">GitHub</a>
          <a href="https://github.com/evropeica/evropeica.github.io/blob/master/docs/RULEBOOK.md">Rulebook</a>
          <a href={withBase('/keyboards/evropeica.kmx')}>Keyman .kmx</a>
        </nav>
        <p class="foot-note">
          Kod — MIT. Specyfikacija ta tekst — CC BY 4.0. &copy; 2026
        </p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* ---------- design tokens ---------- */
  :root {
    --paper:        #faf8f4;
    --paper-raised: #ffffff;
    --paper-sunken: #f2eee6;
    --ink:          #1c1a17;
    --ink-soft:     #5f5950;
    --ink-faint:    #8a8279;
    --rule:         #e4ded2;
    --rule-strong:  #cfc6b6;
    --accent:       #175d78;
    --accent-hover: #10475c;
    --accent-soft:  #e6f0f4;
    --gold:         #9a6f12;
    --gold-soft:    #f6eeda;

    --font-serif: 'Literata', Georgia, 'Times New Roman', serif;
    --font-ui: system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif;
    --font-mono: ui-monospace, 'Cascadia Code', Consolas, monospace;

    --measure: 36rem;
    --container: 64rem;
    --radius: 10px;
    --shadow: 0 1px 2px rgba(28, 26, 23, .04), 0 8px 24px -12px rgba(28, 26, 23, .18);
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper:        #14161a;
      --paper-raised: #1b1e24;
      --paper-sunken: #101216;
      --ink:          #e9e5dd;
      --ink-soft:     #a9a298;
      --ink-faint:    #7c766d;
      --rule:         #2b2f36;
      --rule-strong:  #3c424b;
      --accent:       #7cb8d4;
      --accent-hover: #a3cee2;
      --accent-soft:  #16303c;
      --gold:         #d3a545;
      --gold-soft:    #2b2415;
      --shadow: 0 1px 2px rgba(0,0,0,.3), 0 8px 24px -12px rgba(0,0,0,.6);
    }
  }

  /* ---------- reset ---------- */
  *, *::before, *::after { box-sizing: border-box; }
  * { margin: 0; }

  html { -webkit-text-size-adjust: 100%; scroll-behavior: smooth; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation-duration: .01ms !important; transition-duration: .01ms !important; }
  }

  body {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: var(--ink);
    background: var(--paper);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    text-rendering: optimizeLegibility;
    font-variant-numeric: oldstyle-nums;
  }

  img, svg { max-width: 100%; display: block; }

  .skip {
    position: absolute; left: -9999px;
    background: var(--accent); color: #fff;
    padding: .6rem 1rem; border-radius: 0 0 var(--radius) 0; z-index: 100;
  }
  .skip:focus { left: 0; top: 0; }

  :focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 3px; }

  /* ---------- typography ---------- */
  h1, h2, h3, h4 {
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.011em;
    text-wrap: balance;
  }

  h1 { font-size: clamp(2rem, 1.4rem + 2.6vw, 3rem); margin-block: 0 1rem; }
  h2 {
    font-size: clamp(1.45rem, 1.2rem + 1.1vw, 1.9rem);
    margin-block: 3.25rem 1rem;
    padding-bottom: .45rem;
    border-bottom: 1px solid var(--rule);
  }
  h3 { font-size: 1.2rem; margin-block: 2rem .5rem; }
  h4 { font-size: 1.02rem; margin-block: 1.5rem .35rem; }

  p { margin-block: 0 1rem; }
  p, li { text-wrap: pretty; }

  main > p, main > ul, main > ol { max-width: var(--measure); }

  a { color: var(--accent); text-decoration-thickness: 1px; text-underline-offset: 2px; }
  a:hover { color: var(--accent-hover); }

  strong { font-weight: 600; }

  ul, ol { padding-left: 1.25rem; margin-block: 0 1rem; }
  li { margin-bottom: .3rem; }
  li::marker { color: var(--ink-faint); }

  code {
    font-family: var(--font-mono);
    font-size: .875em;
    background: var(--paper-sunken);
    border: 1px solid var(--rule);
    padding: .1em .35em;
    border-radius: 4px;
    font-variant-numeric: normal;
  }

  hr { border: 0; border-top: 1px solid var(--rule); margin-block: 3rem; }

  /* ---------- tables ---------- */
  .table-wrap { overflow-x: auto; margin-block: 1rem 1.5rem; }
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: .95rem;
    margin-block: 1rem 1.5rem;
  }
  th, td { border-bottom: 1px solid var(--rule); padding: .5rem .7rem; text-align: left; vertical-align: top; }
  thead th {
    background: var(--paper-sunken);
    font-family: var(--font-ui);
    font-size: .72rem;
    font-weight: 600;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-bottom: 1px solid var(--rule-strong);
    white-space: nowrap;
  }
  tbody tr:last-child td { border-bottom: 0; }
  tbody tr:hover td { background: var(--gold-soft); }

  /* ---------- layout ---------- */
  .site-head {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .head-inner {
    max-width: var(--container);
    margin-inline: auto;
    padding: .6rem 1.25rem;
    display: flex; align-items: center; gap: 1.5rem;
    flex-wrap: wrap;
  }
  .brand { display: flex; align-items: center; gap: .55rem; color: var(--ink); text-decoration: none; font-weight: 600; }
  .brand-mark {
    display: grid; place-items: center;
    width: 1.7rem; height: 1.7rem;
    background: var(--accent); color: var(--paper-raised);
    border-radius: 6px; font-size: 1rem; line-height: 1;
    padding-bottom: .1em;
  }
  @media (prefers-color-scheme: dark) { .brand-mark { color: #10151a; } }
  .brand-name { font-size: 1.08rem; letter-spacing: -.01em; }

  .nav { display: flex; gap: .35rem; flex-wrap: wrap; margin-left: auto; font-family: var(--font-ui); }
  .nav-link {
    color: var(--ink-soft); text-decoration: none;
    font-size: .875rem; padding: .3rem .6rem; border-radius: 6px;
  }
  .nav-link:hover { color: var(--ink); background: var(--paper-sunken); }
  .nav-link.active { color: var(--accent); background: var(--accent-soft); font-weight: 600; }

  .main {
    flex: 1; width: 100%;
    max-width: var(--container);
    margin-inline: auto;
    padding: 2.5rem 1.25rem 4rem;
  }
  .main.wide { max-width: 72rem; }

  .site-foot { border-top: 1px solid var(--rule); background: var(--paper-sunken); }
  .foot-inner {
    max-width: var(--container); margin-inline: auto;
    padding: 2rem 1.25rem;
    display: flex; flex-wrap: wrap; gap: .75rem 2rem; align-items: baseline;
  }
  .foot-brand { font-weight: 600; margin: 0; }
  .foot-links { display: flex; gap: 1.1rem; flex-wrap: wrap; font-family: var(--font-ui); font-size: .875rem; }
  .foot-note {
    font-family: var(--font-ui); font-size: .8rem; color: var(--ink-faint);
    margin: 0; margin-left: auto;
  }

  /* ---------- shared page components ---------- */
  .cyr { color: var(--ink-soft); font-style: italic; }

  .bilingual {
    display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem;
    margin-block: 1.25rem 1.5rem;
  }
  .bilingual > div {
    padding: 1.1rem 1.2rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-raised);
  }
  .bilingual > div > *:last-child { margin-bottom: 0; }
  .bilingual .label {
    font-family: var(--font-ui);
    font-size: .68rem; text-transform: uppercase; letter-spacing: .09em;
    color: var(--ink-faint); margin-bottom: .6rem; font-weight: 600;
  }
  @media (max-width: 44rem) {
    .bilingual { grid-template-columns: 1fr; }
    h2 { margin-top: 2.5rem; }
  }
</style>
